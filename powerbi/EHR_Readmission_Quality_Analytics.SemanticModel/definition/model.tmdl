model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["readmission_features", "quality_measure_summary", "data_quality_summary", "operational_flag_summary", "feature_importance_proxy", "readmission_summary_by_service", "risk_tier_summary", "cohort_summary_by_age", "cohort_summary_by_insurance", "dashboard_kpis"]

annotation PBI_ProTooling = ["DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table readmission_features
ref table quality_measure_summary
ref table data_quality_summary
ref table operational_flag_summary
ref table feature_importance_proxy
ref table readmission_summary_by_service
ref table risk_tier_summary
ref table cohort_summary_by_age
ref table cohort_summary_by_insurance
ref table dashboard_kpis

